% ============================================================
% Serpent 2 Input File: UOX Fuel Pin Cell
% ============================================================
%
% This is a simple 2D fuel pin cell model for UOX (Uranium Oxide) fuel
% fz syntax: variables are written with a dollar sign and braces, with an optional
% default after a tilde; formulas (Python) with an at sign and braces.
%
% Reference: Based on Serpent Tutorial examples
% ============================================================

% --- Simulation title ---
set title "UOX Fuel Pin Cell - fz Parametric Study"

% --- Cross section library (adjust path as needed) ---
% set acelib "/path/to/serpent/xsdata/sss_endfb7u.xsdata"

% ============================================================
% MATERIAL DEFINITIONS
% ============================================================

% --- UOX fuel material ---
% U-235 weight fraction is parameterized; U-238 completes the heavy metal so that
% the mass fractions sum to 1 (O-16 fixed at 0.1185)
mat fuel -10.5 tmp 900
92235.09c -${enrichment~0.04}
92238.09c -@{round(0.8815 - $enrichment, 6)}
8016.09c  -0.1185

% --- Zircaloy cladding ---
mat clad -6.56 tmp 600
40090.06c -0.5145
40091.06c -0.1122
40092.06c -0.1715
40094.06c -0.1738
40096.06c -0.0280

% --- Water moderator/coolant ---
mat water -${water_density~0.72} moder lwtr 1001 tmp ${water_temp~600}
1001.06c  2
8016.06c  1

% --- Thermal scattering library for light water ---
therm lwtr lwe7.00t

% ============================================================
% GEOMETRY DEFINITIONS
% ============================================================

% --- Surfaces ---
% Fuel pellet outer radius
surf 1 cyl 0.0 0.0 ${fuel_radius~0.41}

% Cladding inner radius (gap is neglected)
surf 2 cyl 0.0 0.0 ${clad_inner_radius~0.42}

% Cladding outer radius
surf 3 cyl 0.0 0.0 ${clad_outer_radius~0.475}

% Pin cell boundary (square)
surf 4 sqc 0.0 0.0 ${pitch_half~0.63}

% --- Cells ---
% Fuel region
cell 1 0 fuel    -1

% Gap (void) between fuel and cladding
cell 2 0 void     1 -2

% Cladding
cell 3 0 clad     2 -3

% Moderator/coolant
cell 4 0 water    3 -4

% Outside boundary (void)
cell 5 0 outside  4

% ============================================================
% SIMULATION SETTINGS
% ============================================================

% --- Boundary conditions (reflective) ---
set bc 2

% --- Neutron population and criticality cycles ---
% pop <neutrons_per_cycle> <active_cycles> <inactive_cycles>
set pop ${neutrons_per_cycle~50000} ${active_cycles~200} ${inactive_cycles~20}

% --- Seed for random number generator (for reproducibility) ---
set seed ${seed~12345}

% --- Output options ---
set pcc 0

% ============================================================
% END OF INPUT
% ============================================================
